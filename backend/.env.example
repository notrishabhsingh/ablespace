# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local: mongodb://127.0.0.1:27017/pyramid
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/pyramid?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pyramid

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
